{
  "name": "lachvid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "concurrently -n \"next,python\" -c \"cyan,yellow\" \"yarn dev:next\" \"yarn dev:python\"",
    "dev:next": "next dev -p 3005",
    "dev:python": "./backend/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 3006 --reload",
    "build": "next build",
    "start": "next start -p ${PORT:-3005} -H 0.0.0.0",
    "tunnel": "cloudflared tunnel --url http://localhost:3005",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --max-warnings=50",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@hookform/resolvers": "^7.0.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@sqlitecloud/drivers": "^1.0.982",
    "@tailwindcss/postcss": "^4",
    "effect": "^4.1.4",
    "geist": "^1.8.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.64.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
